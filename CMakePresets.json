{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 0,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "tests-debug",
            "displayName": "Debug (with tests)",
            "description": "Debug build with the Unity test suite compiled in",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/tests-debug",
            "toolchainFile": "${sourceDir}/gcc_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "tests-release",
            "displayName": "Release (with tests)",
            "description": "Release build with the Unity test suite compiled in",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/tests-release",
            "toolchainFile": "${sourceDir}/gcc_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (no tests)",
            "description": "Debug build without the Unity test suite",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "toolchainFile": "${sourceDir}/gcc_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "release",
            "displayName": "Release (no tests)",
            "description": "Release build without the Unity test suite",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "toolchainFile": "${sourceDir}/gcc_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "tests-debug",
            "configurePreset": "tests-debug"
        },
        {
            "name": "tests-release",
            "configurePreset": "tests-release"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ]
}