{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug-tests",
            "displayName": "Debug (with tests)",
            "description": "Debug build with the Unity test suite compiled in",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug-tests",
            "toolchainFile": "${sourceDir}/toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (no tests)",
            "description": "Debug build without the Unity test suite",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "toolchainFile": "${sourceDir}/toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "release",
            "displayName": "Release (no tests)",
            "description": "Release build; tests are not permitted in Release, see CMakeLists.txt",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "toolchainFile": "${sourceDir}/toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-tests",
            "configurePreset": "debug-tests"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ]
}